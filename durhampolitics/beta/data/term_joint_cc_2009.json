n_reckhow": 1, "becky_heron": 1, "brenda_howerton": 1, "diane_catotti": 1, "eugene_brown": 1, "farad_ali": 1, "howard_clement": 1, "joe_bowser": 1, "mike_woodard": 1, "pam_karriker": 0, "philip_cousin_jr": 0}, "mike_woodard": {"bill_bell": 1, "michael_page": 1, "cora_cole_mcfadden": 1, "ellen_reckhow": 1, "becky_heron": 1, "brenda_howerton": 1, "diane_catotti": 1, "eugene_brown": 1, "farad_ali": 1, "howard_clement": 1, "joe_bowser": 1, "mike_woodard": 1, "pam_karriker": 0, "philip_cousin_jr": 0}, "pam_karriker": {"bill_bell": 0, "michael_page": 0, "cora_cole_mcfadden": 0, "ellen_reckhow": 0, "becky_heron": 0, "brenda_howerton": 0, "diane_catotti": 0, "eugene_brown": 0, "farad_ali": 0, "howard_clement": 0, "joe_bowser": 0, "mike_woodard": 0, "pam_karriker": 0, "philip_cousin_jr": 0}, "philip_cousin_jr": {"bill_bell": 0, "michael_page": 0, "cora_cole_mcfadden": 0, "ellen_reckhow": 0, "becky_heron": 0, "brenda_howerton": 0, "diane_catotti": 0, "eugene_brown": 0, "farad_ali": 0, "howard_clement": 0, "joe_bowser": 0, "mike_woodard": 0, "pam_karriker": 0, "philip_cousin_jr": 0}}}, "top_conflict_themes": [], "conflicts": [], "topics": [{"label": "Budget & Taxes", "color": "#10b981", "meetings_count": 1, "split_votes_count": 0, "conflicts_count": 0}, {"label": "Governance & Transparency", "color": "#3b82f6", "meetings_count": 1, "split_votes_count": 0, "conflicts_count": 0}], "meetings": [{"id": "joint_cc_2009_03_10_granicus_246", "date": "2009-03-10", "title": "Joint City-County", "meeting_type": "Joint Meeting", "presiding_chair": "Michael D. Page", "duration": "1h 00m", "video_url": "https://durhamcounty.granicus.com/MediaPlayer.php?view_id=3&clip_id=246", "pdf_url": "/durhampolitics/summaries/joint_cc_2009_03_10_granicus_246.pdf", "pdf_exists": true, "executive_summary": "The Joint City-County meeting on March 10, 2009 opened with a unanimous voice vote approving the minutes from the January 13, 2009 meeting on a motion by Howard Clement III. The body then received an extended briefing on a study trip to Portland, Oregon examining a model youth program and alternative public education pathways for disconnected youth. Presenters highlighted opportunities for Durham to compete for a national Gateway to College expansion slot, contrast systemic public-school funding against over-reliance on small nonprofits, and examine Portland's \"Connected by 25\" cross-sector model supported by Oregon's per-pupil funding and philanthropic grants from the Gates and Carnegie foundations. Discussion concluded with an update on local implementation, noting urgency around Southern High School as the state's lowest-performing high school and Durham Public Schools' effort to seek $80,000 to $90,000 to pilot a \"Step Up\" eighth-to-ninth-grade transition program.", "topics": ["Budget & Taxes", "Governance & Transparency"], "votes_count": 1, "split_votes_count": 0, "debates_count": 0, "agenda_items": [{"item_number": "1", "title": "Approval of January 13, 2009 Meeting Minutes", "category": "Governance & Transparency", "discussion_summary": "After waiting briefly for arrivals, the board considered the minutes of the January 13, 2009 Joint City-County meeting. Howard Clement III moved approval, and the motion was seconded (transcribed in ASR as \"Councilman Graham\") and carried by voice vote with no opposition.", "timestamp_label": "00:11:13", "video_timestamp_url": "https://durhamcounty.granicus.com/MediaPlayer.php?view_id=3&clip_id=246&entrytime=673", "vote_summary": "Passed (Voice vote)"}, {"item_number": "2", "title": "Briefing on Portland, Oregon Trip Regarding Model Youth Program", "category": "Governance & Transparency", "discussion_summary": "Presenters including Dr. Datsen and David Ross, introduced alongside Vice Chair Ellen W. Reckhow, briefed the joint boards on lessons from a Portland, Oregon trip focused on disconnected youth and alternative public schools. Key themes included competing for a Gateway to College expansion slot, closing the 16-to-18-year-old educational gap, shifting from over-reliance on under-resourced community nonprofits to systemic public solutions, and engaging business, religious, and political leaders around \"Connected by 25.\" In response to budget questions from Becky M. Heron, presenters described Oregon's \"money follows the student\" model and major Gates and Carnegie foundation grants, and members closed by noting a local $80,000-$90,000 funding need for a Step Up eighth-to-ninth-grade transition pilot feeding into Southern High School.", "timestamp_label": "00:11:37", "video_timestamp_url": "https://durhamcounty.granicus.com/MediaPlayer.php?view_id=3&clip_id=246&entrytime=697", "vote_summary": "Informational / No vote"}], "votes": [{"item_title": "Approval of January 13, 2009 Meeting Minutes", "category": "Governance & Transparency", "outcome": "Passed", "tally": "Voice (unanimous)", "is_split": false, "mover": "Howard Clement III", "seconder": "", "ayes": [], "nays": [], "abstentions": [], "notes": "ASR transcript rendered the mover as 'Councilman Clement' (Howard Clement III) and the seconder as 'Councilman Graham' (no Graham appears in SEATED_BOARD_ROSTER; likely an ASR error for Eugene Brown). Because the vote was taken by voice and full roll-call attendance is not recorded in the transcript digest, individual aye votes are not listed.", "discussion_detail": "Motion to approve the minutes of the January 13, 2009 Joint City-County meeting; carried by voice vote with all in favor and no opposition noted.", "timestamp_label": "00:11:20", "video_timestamp_url": "https://durhamcounty.granicus.com/MediaPlayer.php?view_id=3&clip_id=246&entrytime=680"}], "disagreements": [], "development_cases": [], "search_blob": "joint city-county michael d. page the joint city-county meeting on march 10, 2009 opened with a unanimous voice vote approving the minutes from the january 13, 2009 meeting on a motion by howard clement iii. the body then received an extended briefing on a study trip to portland, oregon examining a model youth program and alternative public education pathways for disconnected youth. presenters highlighted opportunities for durham to compete for a national gateway to college expansion slot, contrast systemic public-school funding against over-reliance on small nonprofits, and examine portland's \"connected by 25\" cross-sector model supported by oregon's per-pupil funding and philanthropic grants from the gates and carnegie foundations. discussion concluded with an update on local implementation, noting urgency around southern high school as the state's lowest-performing high school and durham public schools' effort to seek $80,000 to $90,000 to pilot a \"step up\" eighth-to-ninth-grade transition program. budget & taxes governance & transparency approval of january 13, 2009 meeting minutes briefing on portland, oregon trip regarding model youth program approval of january 13, 2009 meeting minutes "}], "sibling_terms": [{"id": "joint_cc_2026", "label": "2026 Joint City-County", "short_label": "2026", "is_current": true, "meetings_count": 3, "href": "./joint_cc_2026.html"}, {"id": "joint_cc_2025", "label": "2025 Joint City-County", "short_label": "2025", "is_current": false, "meetings_count": 4, "href": "./joint_cc_2025.html"}, {"id": "joint_cc_2024", "label": "2024 Joint City-County", "short_label": "2024", "is_current": false, "meetings_count": 5, "href": "./joint_cc_2024.html"}, {"id": "joint_cc_2023", "label": "2023 Joint City-County", "short_label": "2023", "is_current": false, "meetings_count": 6, "href": "./joint_cc_2023.html"}, {"id": "joint_cc_2022", "label": "2022 Joint City-County", "short_label": "2022", "is_current": false, "meetings_count": 2, "href": "./joint_cc_2022.html"}, {"id": "joint_cc_2021", "label": "2021 Joint City-County", "short_label": "2021", "is_current": false, "meetings_count": 5, "href": "./joint_cc_2021.html"}, {"id": "joint_cc_2020", "label": "2020 Joint City-County", "short_label": "2020", "is_