jacobs": 0}, "sendolo_diaminah": {"fred_foster_jr": 0, "dps_heidi_carter": 0, "michael_page": 0, "brenda_howerton": 0, "dps_mike_lee": 0, "minnie_forte_brown": 0, "ellen_reckhow": 0, "leigh_bordley": 0, "matt_sears": 0, "natalie_beyer": 0, "sendolo_diaminah": 0, "wendy_jacobs": 0}, "wendy_jacobs": {"fred_foster_jr": 0, "dps_heidi_carter": 0, "michael_page": 0, "brenda_howerton": 0, "dps_mike_lee": 0, "minnie_forte_brown": 0, "ellen_reckhow": 0, "leigh_bordley": 0, "matt_sears": 0, "natalie_beyer": 0, "sendolo_diaminah": 0, "wendy_jacobs": 0}}}, "top_conflict_themes": [], "conflicts": [], "topics": [{"label": "Budget & Taxes", "color": "#10b981", "meetings_count": 1, "split_votes_count": 0, "conflicts_count": 0}, {"label": "Governance & Transparency", "color": "#3b82f6", "meetings_count": 1, "split_votes_count": 0, "conflicts_count": 0}, {"label": "School Facilities & Closures", "color": "#06b6d4", "meetings_count": 1, "split_votes_count": 0, "conflicts_count": 0}], "meetings": [{"id": "joint_bocc_boe_2014_09_15_dps_minutes_2014-09-15_september_15_2014_boe", "date": "2014-09-15", "title": "DPS Board of Education — September 15, 2014 Boe &Amp; Bocc Quarterly Meeting", "meeting_type": "Regular Meeting (Official Minutes)", "presiding_chair": "Heidi Carter", "duration": "Official Minutes PDF", "video_url": "https://files-backend.assets.thrillshare.com/documents/asset/uploaded_file/5035/Dps/a9f40b57-70ef-4925-8d5c-9239ed902228/Minutes9.15.14BOE_BOCC.First_Quarterly_Meeting.pdf?disposition=inline", "pdf_url": "/durhampolitics/summaries/joint_bocc_boe_2014_09_15_dps_minutes_2014-09-15_september_15_2014_boe.pdf", "pdf_exists": true, "executive_summary": "On September 15, 2014, the Durham Public Schools Board of Education (BOE) and the Durham Board of County Commissioners (BOCC) held their first 2014–2015 quarterly joint meeting, chaired by BOE Chair Heidi Carter (with BOE member Mike Lee arriving at 9:20 a.m. and BOCC Commissioner Wendy Jacobs absent). Superintendent Dr. Bert L’Homme outlined the district's four 2014–2015 goals—increasing student achievement and graduation rates while reducing suspensions and dropouts—alongside Central Services reorganization into three K–12 Area Superintendents, the Graduate Durham instructional roadmap, mentoring programs, and joint discussion with Commissioner Ellen W. Reckhow on early-grade truancy and a potential county community survey. District leadership also reviewed 7-year enrollment growth (3.7% overall, 15% in middle schools), an initial $181.9 million state allotment offset by a $1.6 million charter-growth reduction, 98% school capacity with 55 mobile units, and 2013–2014 NC Ready results (44.1% Grade Level Proficiency, 34.8% College and Career Readiness, and 73.6% of schools meeting or exceeding expected growth). Finally, officials discussed a sharp rise in incoming Latino and unaccompanied minor high school students (109 enrolled from May to August 13, 2014), prompting BOCC Chair Michael D. Page to recommend a joint retreat with the Health Department and DSS, Chair Carter to request BOCC support for a legislative agenda item granting districts charter-approval authority, and County Manager Wendell Davis to suggest a funding MOU; no formal votes or motions were taken before the meeting adjourned at 11:31 a.m.", "topics": ["Budget & Taxes", "Governance & Transparency", "School Facilities & Closures"], "votes_count": 0, "split_votes_count": 0, "debates_count": 0, "agenda_items": [{"item_number": "1", "title": "Call to Order and Opening Remarks", "category": "Governance & Transparency", "discussion_summary": "Chair Heidi Carter opened the joint meeting with a moment of silence for a Hillside High School senior killed in a weekend single-car accident and welcomed both boards, staff, and visitors. She noted a 2% enrollment increase and emphasized the need for DPS to proactively address the academic and social needs of incoming immigrant children, while welcoming newly seated BOE members. BOCC Chair Michael D. Page welcomed the new school board members and welcomed Superintendent Dr. Bert L’Homme back to Durham Public Schools.", "timestamp_label": "", "video_timestamp_url": "https://files-backend.assets.thrillshare.com/documents/asset/uploaded_file/5035/Dps/a9f40b57-70ef-4925-8d5c-9239ed902228/Minutes9.15.14BOE_BOCC.First_Quarterly_Meeting.pdf?disposition=inline", "vote_summary": "Informational / No vote"}, {"item_number": "2", "title": "Superintendent's General Report – Overall Goals and Objectives", "category": "Governance & Transparency", "discussion_summary": "Superintendent Dr. Bert L’Homme presented DPS's four 2014–2015 goals (increase student achievement, increase graduation rate, decrease suspensions, and decrease drop-out rate) and described reorganizing Central Services around three K–12 Area Superintendents (John McCain, Dr. Alisa McLean, and Jacqueline Ellis). He highlighted the Graduate Durham initiative, restored teacher and principal mentoring programs, the General Assembly's Common Core review commission (for which Vice Chair Minnie Forte-Brown offered to circulate member names), and the appointment of Elizabeth Shearer as Executive Director for Student Services amid high demand for school-based mental health counselors. Commissioner Ellen W. Reckhow cited Robert Balfanz's research on poverty and early truancy, leading to discussion of starting truancy interventions in kindergarten and conducting a Durham County community survey on truancy, crime, and environmental issues.", "timestamp_label": "", "video_timestamp_url": "https://files-backend.assets.thrillshare.com/documents/asset/uploaded_file/5035/Dps/a9f40b57-70ef-4925-8d5c-9239ed902228/Minutes9.15.14BOE_BOCC.First_Quarterly_Meeting.pdf?disposition=inline", "vote_summary": "Informational / No vote"}, {"item_number": "3", "title": "DPS Budget, Enrollment Trends, and Impact of State Legislation", "category": "Budget & Taxes", "discussion_summary": "Deputy Superintendent Hugh Osteen presented seven-year enrollment data showing 3.7% overall growth, driven by flat elementary enrollment, a 15% increase at middle schools, and a 2.1% increase at high schools. Chief Financial Officer Aaron Beaulieu reviewed NCDPI ADM projections versus DPS projections, reporting an initial state allotment of $181.9 million (compared to $177 million projected) alongside a $1.6 million state budget reduction resulting from a 625-student increase in charter school enrollment. He also presented multi-year county appropriation and per-pupil funding charts from 2008–09 through 2014–15 with and without quarter-cent sales tax funding.", "timestamp_label": "", "video_timestamp_url": "https://files-backend.assets.thrillshare.com/documents/asset/uploaded_file/5035/Dps/a9f40b57-70ef-4925-8d5c-9239ed902228/Minutes9.15.14BOE_BOCC.First_Quarterly_Meeting.pdf?disposition=inline", "vote_summary": "Informational / No vote"}, {"item_number": "4", "title": "School Capacity, Mobile Units, and Charter School Impacts", "category": "School Facilities & Closures", "discussion_summary": "Deputy Superintendent Hugh Osteen presented facility capacity data indicating that DPS was operating at 98% capacity with 55 mobile units across elementary, middle, specialty, and high schools, and noted that magnet programs pose planning challenges while offering family choice. Board members discussed enrollment impacts from Voyager Academy on Little River and Mangum Elementary Schools. Members reached informal consensus on developing a marketing strategy to highlight DPS programs to the community.", "timestamp_label": "", "video_timestamp_url": "https://files-backend.assets.thrillshare.com/documents/asset/uploaded_file/5035/Dps/a9f40b57-70ef-4925-8d5c-9239ed902228/Minutes9.15.14BOE_BOCC.First_Quarterly_Meeting.pdf?disposition=inline", "vote_summary": "Informational / No vote"}, {"item_number": "5", "title": "2013-2014 State Testing Results", "category": "Governance & Transparency", "discussion_summary": "Assistant Superintendent Dr. Julie Spencer explained the NC Ready Accountability Model indicators—Grade Level Proficiency (Levels 3–5) and College and Career Readiness (Levels 4–5)—and reported 2013–2014 district results of 44.1% Grade Level Proficiency and 34.8% College and Career Readiness. She reported that 73.6% (39 of 53) of DPS schools met or exceeded expected EVAAS growth, 83% improved or held steady year over year, 55.2% (116 of 210) of AMO targets were met, and ACT WorkKeys proficiency rose 10.2 percentage points to 69.6%. Superintendent L’Homme stated his goal for every DPS school to exceed growth annually and affirmed that every student in DPS can go to college.", "timestamp_label": "", "video_timestamp_url": "https://files-backend.assets.thrillshare.com/documents/asset/uploaded_file/5035/Dps/a9f40b57-70ef-4925-8d5c-9239ed902228/Minutes9.15.14BOE_BOCC.First_Quarterly_Meeting.pdf?disposition=inline", "vote_summary": "Informational / No vote"}, {"item_number": "6", "title": "County Support for Latino Families, Charter Authority Legislative Agenda, and Funding MOU", "category": "Governance & Transparency", "discussion_summary": "Superintendent L’Homme reported that the ESL Resource Center enrolled 109 high school students between May and August 13, 2014 (versus 179 for all of 2013–14), with roughly 75% unaccompanied minors, another 200 students likely by December 2014, and Githens, Jordan, and Riverside experiencing the greatest impact. Following remarks from Dr. Debbie Pitman on ESL and curriculum coordination and Chair Heidi Carter on DPS having no bilingual social workers, BOCC Chair Michael D. Page recommended a joint retreat including the Health Department and DSS. Chair Carter also asked commissioners to join DPS's legislative agenda requesting local school district authority to approve new charter schools, and County Manager Wendell Davis suggested establishing a funding MOU to structure future budget discussions before the meeting adjourned at 11:31 a.m.", "timestamp_label": "", "video_timestamp_url": "https://files-backend.assets.thrillshare.com/documents/asset/uploaded_file/5035/Dps/a9f40b57-70ef-4925-8d5c-9239ed902228/Minutes9.15.14BOE_BOCC.First_Quarterly_Meeting.pdf?disposition=inline", "vote_summary": "Informational / No vote"}], "votes": [], "disagreements": [], "development_cases": [], "search_blob": "dps board of education — september 15, 2014 boe &amp; bocc quarterly meeting heidi carter on september 15, 2014, the durham public schools board of education (boe) and the durham board of county commissioners (bocc) held their first 2014–2015 quarterly joint meeting, chaired by boe chair heidi carter (with boe member mike lee arriving at 9:20 a.m. and bocc commissioner wendy jacobs absent). superintendent dr. bert l’homme outlined the district's four 2014–2015 goals—increasing student achievement and graduation rates while reducing suspensions and dropouts—alongside central services reorganization into three k–12 area superintendents, the graduate durham instructional roadmap, mentoring programs, and joint discussion with commissioner ellen w. reckhow on early-grade truancy and a potential county community survey. district leadership also reviewed 7-year enrollment growth (3.7% overall, 15% in middle schools), an initial $181.9 million state allotment offset by a $1.6 million charter-growth reduction, 98% school capacity with 55 mobile units, and 2013–2014 nc ready results (44.1% grade level proficiency, 34.8% college and career readiness, and 73.6% of schools meeting or exceeding expected growth). finally, officials discussed a sharp rise in incoming latino and unaccompanied minor high school students (109 enrolled from may to august 13, 2014), prompting bocc chair michael d. page to recommend a joint retreat with the health department and dss, chair carter to request bocc support for a legislative agenda item granting districts charter-approval authority, and county manager wendell davis to suggest a funding mou; no formal votes or motions were taken before the meeting adjourned at 11:31 a.m. budget & taxes governance & transparency school facilities & closures call to order and opening remarks superintendent's general report – overall goals and objectives dps budget, enrollment trends, and impact of state legislation school capacity, mobile units, and charter school impacts 2013-2014 state testing results county support for latino families, charter authority legislative agenda, and funding mou  "}], "sibling_terms": [{"id": "joint_bocc_boe_2026", "label": "2026 Joint BOCC–BOE", "short_label": "2026", "is_current": true, "meetings_count": 2, "href": "./joint_bocc_boe_2026.html"}, {"id": "joint_bocc_boe_2025", "label": "2025 Joint BOCC–BOE", "short_label": "2025", "is_current": false, "meetings_count": 3, "href": "./joint_bocc_boe_2025.html"}, {"id": "joint_bocc_boe_2024", "label": "2024 Joint BOCC–BOE", "short_label": "2024", "is_current": false, "meetings_count": 4, "href": "./joint_bocc_boe_2024.html"}, {"id": "joint_bocc_boe_2023", "label": "2023 Joint BOCC–BOE", "short_label": "2023", "is_current": false, "meetings_count": 4, "href": "./joint_bocc_boe_2023.html"}, {"id": "joint_bocc_boe_2022", "label": "2022 Joint BOCC–BOE", "short_label": "2022", "is_current": false, "meetings_count": 5, "href": "./joint_bocc_boe_2022.html"}, {"id": "joint_bocc_boe_2021", "label": "2021 Joint BOCC–BOE", "short_label": "2021", "is_current": false, "meetings_count": 4, "href": "./joint_bocc_boe_2021.html"}, {"id": "joint_bocc_boe_2020", "label": "2020 Joint BOCC–BOE", "short_label": "2020", "is_current": false, "meetings_count": 3, "href": "./joint_bocc_boe_2020.html"}, {"id": "joint_bocc_boe_2019", "label": "2019 Joint BOCC–BOE", "short_label": "2019", "is_current": false, "meetings_count": 2, "href": "./joint_bocc_boe_2019.html"}, {"id": "joint_bocc_boe_2018", "label": "2018 Joint BOCC–BOE", "short_label": "2018", "is_current": false, "meetings_count": 1, "href": "./joint_bocc_boe_2018.html"}, {"id": "joint_bocc_boe_2014", "label": "2014 Joint BOCC–BOE", "short_label": "2014", "is_current": false, "meetings_count": 1, "href": "./joint_bocc_boe_2014.html"}, {"id": "joint_bocc_boe_2008", "label": "2008 Joint BOCC–BOE", "short_label": "2008", "is_current": false, "meetings_count": 1, "href": "./joint_bocc_boe_2008.html"}]}