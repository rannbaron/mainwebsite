eidi_carter": 1, "matt_sears": 1, "minnie_forte_brown": 1, "natalie_beyer": 1, "steve_unruhe": 1, "xavier_cason": 1}, "xavier_cason": {"dps_mike_lee": 1, "wendy_jacobs": 1, "bettina_umstead": 1, "james_hill": 1, "brenda_howerton": 1, "ellen_reckhow": 1, "bocc_heidi_carter": 1, "matt_sears": 1, "minnie_forte_brown": 1, "natalie_beyer": 1, "steve_unruhe": 1, "xavier_cason": 1}}}, "top_conflict_themes": [], "conflicts": [], "topics": [{"label": "Staff Compensation & Labor", "color": "#f59e0b", "meetings_count": 1, "split_votes_count": 0, "conflicts_count": 0}, {"label": "School Facilities & Closures", "color": "#06b6d4", "meetings_count": 1, "split_votes_count": 0, "conflicts_count": 0}, {"label": "Budget & Taxes", "color": "#10b981", "meetings_count": 1, "split_votes_count": 0, "conflicts_count": 0}, {"label": "Governance & Transparency", "color": "#3b82f6", "meetings_count": 1, "split_votes_count": 0, "conflicts_count": 0}], "meetings": [{"id": "dps_2018_11_20_dx73d8trhXs", "date": "2018-11-20", "title": "Joint BOCC-BOE Meeting November 20, 2018 9:00 AM", "meeting_type": "Joint Meeting", "presiding_chair": "Dr. Mike Lee", "duration": "1h 59m", "video_url": "https://www.youtube.com/watch?v=dx73d8trhXs", "pdf_url": "/durhampolitics/summaries/dps_2018_11_20_dx73d8trhXs.pdf", "pdf_exists": true, "executive_summary": "At the November 20, 2018 joint meeting of the Durham Board of County Commissioners and Durham Public Schools Board of Education (presided over by Dr. Mike Lee), the two boards deferred approval of the August 21 joint meeting minutes for edits and unanimously voted to reorder the agenda to accommodate departing commissioners. Presentations and discussion focused on DPS's enrollment decline of over 600 students alongside charter school growth to 6,957 students, severe elementary classroom capacity pressures from North Carolina's K-3 class-size mandate, and the need for capital planning including two new elementary schools. Staff and Child Care Services Association leaders also presented Durham Pre-K expansion plans, Exceptional Children identification of roughly 350 new preschoolers with disabilities annually, and the new high-school Construction Collaborative apprenticeship pathway with Durham Tech. During public comment, Jovonia Lewis of the Durham Committee on the Affairs of Black People requested follow-up on prior community conversations, prompting commitments from both boards to show more clearly how resident feedback shapes budgets and policies. No split votes occurred.", "topics": ["Budget & Taxes", "Governance & Transparency", "School Facilities & Closures", "Staff Compensation & Labor"], "votes_count": 1, "split_votes_count": 0, "debates_count": 0, "agenda_items": [{"item_number": "1", "title": "Call to Order, Moment of Silence, and Deferral of August 21, 2018 Minutes", "category": "Governance & Transparency", "discussion_summary": "Dr. Mike Lee called the joint BOCC-BOE meeting to order and led a moment of silence. After a member noted concerns with statements attributed to them in the August 21, 2018 joint meeting minutes and requested time to submit edits, the boards agreed to defer approval of the August 21 minutes until the next joint meeting.", "timestamp_label": "00:01:12", "video_timestamp_url": "https://www.youtube.com/watch?v=dx73d8trhXs&t=72s", "vote_summary": "Deferred / No vote"}, {"item_number": "2", "title": "Agenda Review and Reordering", "category": "Governance & Transparency", "discussion_summary": "Because two county commissioners had to leave after 30 minutes and had already heard the Pre-K study, the boards agreed to move item 4A to the end of the agenda and move item 8 immediately after item 4. A motion to approve the amended agenda passed unanimously by voice vote.", "timestamp_label": "00:05:58", "video_timestamp_url": "https://www.youtube.com/watch?v=dx73d8trhXs&t=358s", "vote_summary": "Passed Unanimously"}, {"item_number": "3", "title": "K-3 Class Size Mandate, Student Enrollment, and Classroom Capacity Update", "category": "School Facilities & Closures", "discussion_summary": "Staff reported that DPS enrollment fell by over 600 students in 2018-19 (from 33,181 to 32,520) while charter enrollment rose from 6,506 to 6,957, bringing total Durham County public/charter students to roughly 39,500. Board members and commissioners discussed combination classes, arts and enhancement teachers losing dedicated rooms, trade-offs between kindergarten and Pre-K space at Burton and Merrick-Moore, community access to the Whitted gym, and long-range capital needs to build two new elementary schools and plan redistricting.", "timestamp_label": "00:12:42", "video_timestamp_url": "https://www.youtube.com/watch?v=dx73d8trhXs&t=762s", "vote_summary": "Informational / No vote"}, {"item_number": "4", "title": "DPS Pre-K and Exceptional Children Enrollment Update", "category": "School Facilities & Closures", "discussion_summary": "Suzanne Carterman presented DPS Pre-K capacity and Exceptional Children (EC) enrollment data, noting Eno Valley's 45 filled slots across four classrooms and explaining that DPS identifies roughly 350 new preschool children with disabilities each year who must be served. Board members emphasized protecting existing Pre-K capacity despite unfunded K-3 facility pressures.", "timestamp_label": "00:42:57", "video_timestamp_url": "https://www.youtube.com/watch?v=dx73d8trhXs&t=2577s", "vote_summary": "Informational / No vote"}, {"item_number": "5", "title": "Construction Collaborative Career Pathway Report", "category": "Staff Compensation & Labor", "discussion_summary": "DPS staff presented the Construction Collaborative program, embedding high school juniors in three-hour afternoon skilled-trades sessions and moving seniors into paid company apprenticeships with a direct articulation pathway to Durham Tech's two-year construction/project management degree. Board members and commissioners praised the program as a first-choice 'Plan A' option, urged keeping it at Southern High School with strong parent engagement, and asked about student selection.", "timestamp_label": "00:48:51", "video_timestamp_url": "https://www.youtube.com/watch?v=dx73d8trhXs&t=2931s", "vote_summary": "Informational / No vote"}, {"item_number": "6", "title": "Durham Pre-K Supply and Demand Study & Expansion Update", "category": "Budget & Taxes", "discussion_summary": "A representative of Child Care Services Association summarized the county-funded Pre-K supply and demand study and Durham Pre-K expansion following the 2016 early childhood task force. The presentation highlighted gaps for families at Durham's median family income who do not qualify for Head Start, the public-private expansion model, the Pipeline to Pre-K quality-improvement track, and additional Durham Pre-K funding available for Whitted and future DPS classrooms.", "timestamp_label": "01:12:23", "video_timestamp_url": "https://www.youtube.com/watch?v=dx73d8trhXs&t=4343s", "vote_summary": "Informational / No vote"}, {"item_number": "7", "title": "Public Comment and Community Conversations Follow-Up", "category": "Governance & Transparency", "discussion_summary": "Jovonia Lewis, chair of the education committee for the Durham Committee on the Affairs of Black People, asked whether there had been follow-up after community conversations. County and school officials explained that community feedback had been summarized and incorporated into strategic plans and budget priorities, while board members agreed the boards must explicitly communicate back to residents how public input shaped policies and budgets.", "timestamp_label": "01:52:09", "video_timestamp_url": "https://www.youtube.com/watch?v=dx73d8trhXs&t=6729s", "vote_summary": "Informational / No vote"}], "votes": [{"item_title": "Approval of Amended Joint BOCC-BOE Meeting Agenda", "category": "Governance & Transparency", "outcome": "Passed", "tally": "Unanimous", "is_split": false, "mover": "", "seconder": "", "ayes": [], "nays": [], "abstentions": [], "notes": "Unanimous voice vote of attending BOE and BOCC members; individual mover, seconder, and joint attendance headcount were not read aloud in the transcript.", "discussion_detail": "Joint boards moved and seconded approving the agenda as amended to move item 4A to the end and item 8 after item 4.", "timestamp_label": "00:08:16", "video_timestamp_url": "https://www.youtube.com/watch?v=dx73d8trhXs&t=496s"}], "disagreements": [], "search_blob": "joint bocc-boe meeting november 20, 2018 9:00 am dr. mike lee at the november 20, 2018 joint meeting of the durham board of county commissioners and durham public schools board of education (presided over by dr. mike lee), the two boards deferred approval of the august 21 joint meeting minutes for edits and unanimously voted to reorder the agenda to accommodate departing commissioners. presentations and discussion focused on dps's enrollment decline of over 600 students alongside charter school growth to 6,957 students, severe elementary classroom capacity pressures from north carolina's k-3 class-size mandate, and the need for capital planning including two new elementary schools. staff and child care services association leaders also presented durham pre-k expansion plans, exceptional children identification of roughly 350 new preschoolers with disabilities annually, and the new high-school construction collaborative apprenticeship pathway with durham tech. during public comment, jovonia lewis of the durham committee on the affairs of black people requested follow-up on prior community conversations, prompting commitments from both boards to show more clearly how resident feedback shapes budgets and policies. no split votes occurred. budget & taxes governance & transparency school facilities & closures staff compensation & labor call to order, moment of silence, and deferral of august 21, 2018 minutes agenda review and reordering k-3 class size mandate, student enrollment, and classroom capacity update dps pre-k and exceptional children enrollment update construction collaborative career pathway report durham pre-k supply and demand study & expansion update public comment and community conversations follow-up approval of amended joint bocc-boe meeting agenda "}], "sibling_terms": [{"id": "joint_bocc_boe_2026", "label": "2026 Joint BOCC–BOE", "short_label": "2026", "is_current": true, "meetings_count": 1, "href": "./joint_bocc_boe_2026.html"}, {"id": "joint_bocc_boe_2025", "label": "2025 Joint BOCC–BOE", "short_label": "2025", "is_current": false, "meetings_count": 1, "href": "./joint_bocc_boe_2025.html"}, {"id": "joint_bocc_boe_2024", "label": "2024 Joint BOCC–BOE", "short_label": "2024", "is_current": false, "meetings_count": 3, "href": "./joint_bocc_boe_2024.html"}, {"id": "joint_bocc_boe_2023", "label": "2023 Joint BOCC–BOE", "short_label": "2023", "is_current": false, "meetings_count": 4, "href": "./joint_bocc_boe_2023.html"}, {"id": "joint_bocc_boe_2022", "label": "2022 Joint BOCC–BOE", "short_label": "2022", "is_current": false, "meetings_count": 5, "href": "./joint_bocc_boe_2022.html"}, {"id": "joint_bocc_boe_2021", "label": "2021 Joint BOCC–BOE", "short_label": "2021", "is_current": false, "meetings_count": 4, "href": "./joint_bocc_boe_2021.html"}, {"id": "joint_bocc_boe_2020", "label": "2020 Joint BOCC–BOE", "short_label": "2020", "is_current": false, "meetings_count": 3, "href": "./joint_bocc_boe_2020.html"}, {"id": "joint_bocc_boe_2019", "label": "2019 Joint BOCC–BOE", "short_label": "2019", "is_current": false, "meetings_count": 2, "href": "./joint_bocc_boe_2019.html"}, {"id": "joint_bocc_boe_2018", "label": "2018 Joint BOCC–BOE", "short_label": "2018", "is_current": false, "meetings_count": 1, "href": "./joint_bocc_boe_2018.html"}]}