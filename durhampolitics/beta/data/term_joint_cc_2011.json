n_reckhow": 2, "becky_heron": 2, "brenda_howerton": 2, "diane_catotti": 2, "eugene_brown": 2, "farad_ali": 2, "howard_clement": 2, "joe_bowser": 2, "mike_woodard": 2, "pam_karriker": 0, "philip_cousin_jr": 0}, "mike_woodard": {"bill_bell": 2, "michael_page": 2, "cora_cole_mcfadden": 2, "ellen_reckhow": 2, "becky_heron": 2, "brenda_howerton": 2, "diane_catotti": 2, "eugene_brown": 2, "farad_ali": 2, "howard_clement": 2, "joe_bowser": 2, "mike_woodard": 2, "pam_karriker": 0, "philip_cousin_jr": 0}, "pam_karriker": {"bill_bell": 0, "michael_page": 0, "cora_cole_mcfadden": 0, "ellen_reckhow": 0, "becky_heron": 0, "brenda_howerton": 0, "diane_catotti": 0, "eugene_brown": 0, "farad_ali": 0, "howard_clement": 0, "joe_bowser": 0, "mike_woodard": 0, "pam_karriker": 0, "philip_cousin_jr": 0}, "philip_cousin_jr": {"bill_bell": 0, "michael_page": 0, "cora_cole_mcfadden": 0, "ellen_reckhow": 0, "becky_heron": 0, "brenda_howerton": 0, "diane_catotti": 0, "eugene_brown": 0, "farad_ali": 0, "howard_clement": 0, "joe_bowser": 0, "mike_woodard": 0, "pam_karriker": 0, "philip_cousin_jr": 0}}}, "top_conflict_themes": [], "conflicts": [], "topics": [{"label": "Governance & Transparency", "color": "#3b82f6", "meetings_count": 1, "split_votes_count": 0, "conflicts_count": 0}, {"label": "Budget & Taxes", "color": "#10b981", "meetings_count": 1, "split_votes_count": 0, "conflicts_count": 0}], "meetings": [{"id": "joint_cc_2011_02_07_city_granicus_777", "date": "2011-02-07", "title": "City Council & Board of County Commissioners (Durham Convention Center))", "meeting_type": "Regular Meeting", "presiding_chair": "Bill Bell", "duration": "59m", "video_url": "https://durham.granicus.com/MediaPlayer.php?view_id=5&clip_id=777", "pdf_url": "/durhampolitics/summaries/joint_cc_2011_02_07_city_granicus_777.pdf", "pdf_exists": true, "executive_summary": "In a joint special session, the Durham City Council and the Durham Board of County Commissioners reviewed and approved two contracts with Global Spectrum to manage the Durham Convention Center: a pre-opening consulting/transition agreement running through June 30, 2011, and a five-year management agreement (three-year initial term with a two-year renewal option). City General Services Director Joel Reitzer presented negotiated contract revisions, including shifting the incentive fee split to 70% financial performance and 30% qualitative customer/corporate service (capped at the management fee), reducing the working-capital allowance from $250,000 to $150,000 at 8% interest amortized over three years, and adding an early-termination right if budget targets are missed for two consecutive years. Council members and commissioners questioned the necessity, timing, and budget modeling of incentive payments, annual appropriation oversight via the Civic Center Board, upcoming air-lease utility metering negotiations with Shaner Hotel Group, SDB/MWBE compliance, and off-peak pricing for nonprofits. Both bodies approved the agreements unanimously by voice vote, with no split votes or recorded dissent (City Council passed on a motion by Mike Woodard; BOCC passed on a motion by Becky M. Heron, seconded by Brenda A. Howerton).", "topics": ["Budget & Taxes", "Governance & Transparency"], "votes_count": 2, "split_votes_count": 0, "debates_count": 0, "agenda_items": [{"item_number": "1", "title": "Durham Convention Center Consulting and Management Contracts Overview", "category": "Budget & Taxes", "discussion_summary": "Staff and City General Services Director Joel Reitzer summarized two proposed contracts with Global Spectrum: a construction-period consulting/transition contract through June 30, 2011, and a five-year (three-year plus two-year renewal) management contract. Key revisions reduced the financial performance portion of the incentive fee from 75% to 70% while increasing the qualitative customer-and-corporate-service share from 25% to 30% (15% overall financial performance, 5% corporate citizenry, 5% customer service, and 5% asset management), capped at the annual management fee. The advance/working-capital allowance was also reduced from $250,000 to $150,000 at 8% annual interest, amortized over three years instead of five.", "timestamp_label": "00:00:00", "video_timestamp_url": "https://durham.granicus.com/MediaPlayer.php?view_id=5&clip_id=777&entrytime=0", "vote_summary": "Informational / No vote"}, {"item_number": "2", "title": "Incentive Fee Structure, Budget Modeling, and Termination Protections", "category": "Budget & Taxes", "discussion_summary": "Mayor Bill Bell and commissioners questioned why an incentive fee was necessary and whether first-year incentives (projected around $30,000 for qualitative performance on $1.6 million in projected gross revenue) should be budgeted only after year-end audit verification. Staff explained that the budget cycle required three-year modeling with an 8–10% contingency (such as budgeting $800,000 for a $724,000 projection) to avoid mid-year budget amendments. Staff also noted a negotiated bottom-line protection granting an early termination right if Global Spectrum misses budget thresholds for two consecutive years.", "timestamp_label": "00:06:05", "video_timestamp_url": "https://durham.granicus.com/MediaPlayer.php?view_id=5&clip_id=777&entrytime=365", "vote_summary": "Informational / No vote"}, {"item_number": "3", "title": "Annual Budget Oversight, Joint Account Controls, and Benchmarking", "category": "Governance & Transparency", "discussion_summary": "Staff detailed the annual budget review pipeline from Global Spectrum to City/County staff, advisory review by the Convention Center Authority (Civic Center) Board, and final appropriation by the City Council and BOCC. The contract establishes a jointly owned operating account with City and County signatory authority and monthly financial reporting, and aligns the current fiscal year's transition budget following a six-month extension to Shaner. Officials also reviewed IRS/statutory contract restrictions (97-13) and Commissioner Ellen W. Reckhow noted that Global Spectrum outperformed projected operating deficits at comparable convention centers.", "timestamp_label": "00:34:21", "video_timestamp_url": "https://durham.granicus.com/MediaPlayer.php?view_id=5&clip_id=777&entrytime=2061", "vote_summary": "Informational / No vote"}, {"item_number": "4", "title": "Shaner Air Lease Utilities, SDB/MWBE Compliance, and Nonprofit Pricing", "category": "Governance & Transparency", "discussion_summary": "Staff reported that newly installed electrical and HVAC check meters will inform an upcoming amendment to the air lease with Shaner Hotel Group to clarify utility charges. Responding to Mayor Pro Tempore Cora Cole-McFadden, staff confirmed that the contract administrator will oversee equal opportunity and SDB/MWBE compliance. Staff also explained that Global Spectrum will use yield management to offer off-peak pricing to nonprofits and community groups with limited budgets in coordination with staff.", "timestamp_label": "00:49:39", "video_timestamp_url": "https://durham.granicus.com/MediaPlayer.php?view_id=5&clip_id=777&entrytime=2979", "vote_summary": "Informational / No vote"}, {"item_number": "5", "title": "City Council Approval of Global Spectrum Consulting and Management Agreements", "category": "Budget & Taxes", "discussion_summary": "Mayor Bill Bell entertained a motion from the City Council on Attachments 1 and 2 comprising the transition consulting agreement and the five-year management agreement with Global Spectrum. Council Member Mike Woodard moved acceptance of the two agreements as presented, and an unidentified member seconded the motion. The City Council approved the motion unanimously by voice vote without further debate.", "timestamp_label": "00:58:35", "video_timestamp_url": "https://durham.granicus.com/MediaPlayer.php?view_id=5&clip_id=777&entrytime=3515", "vote_summary": "Passed (Unanimous)"}, {"item_number": "6", "title": "Board of County Commissioners Approval of Global Spectrum Agreements", "category": "Budget & Taxes", "discussion_summary": "BOCC Chair Michael D. Page entertained a motion for the County on the transition-period agreement for the remainder of FY 2010–11 and the management agreement starting the next fiscal year, noting that special-session rules allowed immediate action. Commissioner Becky M. Heron moved approval and Commissioner Brenda A. Howerton seconded. The Board of County Commissioners approved the motion unanimously by voice vote before adjourning the joint session.", "timestamp_label": "00:59:00", "video_timestamp_url": "https://durham.granicus.com/MediaPlayer.php?view_id=5&clip_id=777&entrytime=3540", "vote_summary": "Passed (Unanimous)"}], "votes": [{"item_title": "City Council Approval of Global Spectrum Consulting and Management Agreements (Attachments 1 and 2)", "category": "Budget & Taxes", "outcome": "Passed", "tally": "Unanimous", "is_split": false, "mover": "Mike Woodard", "seconder": "", "ayes": [], "nays": [], "abstentions": [], "notes": "Presided over by Mayor Bill Bell. Seconded by an unnamed council member. Passed unanimously by voice vote; individual roll-call attendance was not read in the transcript.", "discussion_detail": "City Council voted to accept Attachments 1 and 2, consisting of the pre-opening consulting/transition contract through June 30, 2011 and the 3+2 year management contract with Global Spectrum for the Durham Convention Center.", "timestamp_label": "00:58:35", "video_timestamp_url": "https://durham.granicus.com/MediaPlayer.php?view_id=5&clip_id=777&entrytime=3515"}, {"item_title": "Board of County Commissioners Approval of Global Spectrum Transition and Management Agreements", "category": "Budget & Taxes", "outcome": "Passed", "tally": "Unanimous", "is_split": false, "mover": "Becky M. Heron", "seconder": "Brenda A. Howerton", "ayes": [], "nays": [], "abstentions": [], "notes": "Presided over by BOCC Chair Michael D. Page. Passed unanimously by voice vote; individual roll-call attendance was not read in the transcript.", "discussion_detail": "Board of County Commissioners voted to approve the transition-period agreement for the remainder of the current fiscal year and the management agreement for the following year without needing to suspend rules due to the special-session call.", "timestamp_label": "00:59:00", "video_timestamp_url": "https://durham.granicus.com/MediaPlayer.php?view_id=5&clip_id=777&entrytime=3540"}], "disagreements": [], "development_cases": [], "boe_dae_events": [], "bocc_manager_events": [], "search_blob": "city council & board of county commissioners (durham convention center)) bill bell in a joint special session, the durham city council and the durham board of county commissioners reviewed and approved two contracts with global spectrum to manage the durham convention center: a pre-opening consulting/transition agreement running through june 30, 2011, and a five-year management agreement (three-year initial term with a two-year renewal option). city general services director joel reitzer presented negotiated contract revisions, including shifting the incentive fee split to 70% financial performance and 30% qualitative customer/corporate service (capped at the management fee), reducing the working-capital allowance from $250,000 to $150,000 at 8% interest amortized over three years, and adding an early-termination right if budget targets are missed for two consecutive years. council members and commissioners questioned the necessity, timing, and budget modeling of incentive payments, annual appropriation oversight via the civic center board, upcoming air-lease utility metering negotiations with shaner hotel group, sdb/mwbe compliance, and off-peak pricing for nonprofits. both bodies approved the agreements unanimously by voice vote, with no split votes or recorded dissent (city council passed on a motion by mike woodard; bocc passed on a motion by becky m. heron, seconded by brenda a. howerton). budget & taxes governance & transparency durham convention center consulting and management contracts overview incentive fee structure, budget modeling, and termination protections annual budget oversight, joint account controls, and benchmarking shaner air lease utilities, sdb/mwbe compliance, and nonprofit pricing city council approval of global spectrum consulting and management agreements board of county commissioners approval of global spectrum agreements city council approval of global spectrum consulting and management agreements (attachments 1 and 2) board of county commissioners approval of global spectrum transition and management agreements "}], "sibling_terms": [{"id": "joint_cc_2026", "label": "2026 Joint City-County", "short_label": "2026", "is_current": true, "meetings_count": 3, "href": "./joint_cc_2026.html"}, {"id": "joint_cc_2025", "label": "2025 Joint City-County", "short_label": "2025", "is_current": false, "meetings_count": 4, "href": "./joint_cc_2025.html"}, {"id": "joint_cc_2024", "label": "2024 Joint City-County", "short_label": "2024", "is_current": false, "meetings_count": 5, "href": "./joint_cc_2024.html"}, {"id": "joint_cc_2023", "label": "2023 Joint City-County", "short_label": "2023", "is_current": false, "meetings_count": 6, "href": "./joint_cc_2023.html"}, {"id": "joint_cc_2022", "label": "2022 Joint City-County", "short_label": "2022", "is_current": false, "meetings_count": 2, "href": "./joint_cc_2022.html"}, {"id": "joint_cc_2021", "label": "2021 Joint City-County", "short_label": "2021", "is_current": false, "meetings_count": 5, "href": "./joint_cc_2021.html"}, {"id": "joint_cc_2020", "label": "2020 Joint City-County", "short_label": "2020", "is_current": false, "meetings_count": 5, "href": "./joint_cc_2020.html"}, {"id": "joint_cc_2019", "label": "2019 Joint City-County", "short_label": "2019", "is_current": false, "meetings_count": 3, "href": "./joint_cc_2019.html"}, {"id": "joint_cc_2018", "label": "2018 Jo